# Supabase project, safe to expose to the browser.
#
# The scripts in scripts/ also accept SUPABASE_URL and SUPABASE_ANON_KEY
# without the prefix, and prefer the real environment over this file. The
# prefixed names are the ones the browser bundle reads, so set those.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only. Never prefixed with VITE_, never read from client code.
GEMINI_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
